# Copy this file to .env and fill in values locally. NEVER commit .env or share it.
# Every key here is optional until the chapter that uses it.

# Which Binance environment the bot talks to: testnet or live (Chapter 8). Start with testnet.
BINANCE_ENV=testnet
# Futures API key for the bot's own subaccount. Create it WITHOUT withdrawal permission.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Shared secret that TradingView alerts must include in their JSON body (Chapter 7).
WEBHOOK_SECRET=

# Telegram bot for alerts (Chapter 8).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude API key for agents built with the Claude Agent SDK (Chapter 9).
ANTHROPIC_API_KEY=
